<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
  <components>
    <flow-layout direction="vertical">
      <children>
        <flow-layout direction="vertical">
          <children>
            <flow-layout direction="vertical">
              <children>
                <label>
                  <text translate="true">gui.blocks_blocks.soul_niche_blockmen.title</text>
                  <shadow>true</shadow>
                </label>
              </children>

              <padding>
                <all>8</all>
              </padding>

              <surface>
                <blur quality="0.15" size="16"/>
                <outline>black</outline>
              </surface>

              <sizing>
                <horizontal method="fill">100</horizontal>
              </sizing>
              <vertical-alignment>center</vertical-alignment>
              <horizontal-alignment>center</horizontal-alignment>
            </flow-layout>

            <scroll direction="vertical">
              <flow-layout direction="vertical" id="info-container">
                <children>
                </children>

                <gap>8</gap>

              </flow-layout>
              <scrollbar-thiccness>4</scrollbar-thiccness>

              <surface>
                <blur quality="0.1" size="16"/>
                <outline>black</outline>
              </surface>

              <padding>
                <all>16</all>
              </padding>

              <sizing>
                <vertical method="fill">50</vertical>
                <horizontal method="fill">100</horizontal>
              </sizing>

              <vertical-alignment>center</vertical-alignment>
              <horizontal-alignment>center</horizontal-alignment>
            </scroll>
          </children>

          <sizing>
            <horizontal method="fill">60</horizontal>
          </sizing>

          <horizontal-alignment>center</horizontal-alignment>
          <vertical-alignment>center</vertical-alignment>
        </flow-layout>
      </children>

      <vertical-alignment>center</vertical-alignment>
      <horizontal-alignment>center</horizontal-alignment>

      <surface>
        <options-background/>
      </surface>
    </flow-layout>
  </components>

  <templates>
    <template name="info">
      <flow-layout direction="horizontal">
        <children>
          <item>
            <stack>blocks_blocks:soul</stack>
            <tooltip-text>{{name}}</tooltip-text>
          </item>
          <label>
            <text>{{name}}</text>
            <sizing>
              <vertical method="fixed">16</vertical>
            </sizing>
            <vertical-text-alignment>center</vertical-text-alignment>
          </label>
        </children>
        <gap>8</gap>
      </flow-layout>
    </template>
  </templates>
</owo-ui>